# Copy to .env and fill in your own values.
# DB/model/retrieval settings are namespaced with CODECOPILOT_ so they never
# collide with another project's env vars already exported on your machine.

GEMINI_API_KEY=your_key_here

CODECOPILOT_DB_USER=your_db_user
CODECOPILOT_DB_PASSWORD=
CODECOPILOT_DB_HOST=localhost
CODECOPILOT_DB_PORT=5432
CODECOPILOT_DB_NAME=codebase_copilot

CODECOPILOT_GEMINI_MODEL=gemini-2.5-flash
CODECOPILOT_EMBEDDING_MODEL=all-MiniLM-L6-v2
CODECOPILOT_RETRIEVAL_K=5
CODECOPILOT_FINAL_K=5
CODECOPILOT_PROMPT_VERSION=answer_v1
CODECOPILOT_TRACE_LOG_PATH=traces.jsonl
